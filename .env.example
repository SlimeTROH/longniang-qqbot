# NoneBot / OneBot v11 正向 WebSocket
DRIVER=~fastapi+~httpx+~websockets
HOST=127.0.0.1
PORT=8080
ONEBOT_WS_URLS=["ws://127.0.0.1:3002"]
ONEBOT_ACCESS_TOKEN=
QQBOT_ACCOUNT=
QQBOT_AUTO_RECOVER=0

# 龙娘聊天
CHAT_OPENAI_API_KEY=
CHAT_ADMIN_LIST=
CHAT_ENABLED_GROUPS=
CHAT_TRIGGER_NAMES=龙娘
CHAT_PRIVATE_ENABLED=0

# 可选功能
CHAT_WEB_ADMIN=
CHAT_WEB_TOKEN=
DSH_BRIDGE_ENABLED=0
DSH_BRIDGE_ALLOWLIST=
